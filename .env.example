# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
NODE_ENV=development

# ==========================================
# BASE DE DATOS (SUPABASE)
# ==========================================
# Usada por Express (Prisma) - Solo esquema auth
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true&schema=auth"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Usada por FastAPI (SQLAlchemy) - Solo esquema business
BUSINESS_DATABASE_URL="postgresql://usuario:password@host:5432/postgres?options=-csearch_path%3Dbusiness"

# ==========================================
# AUTH SERVICE (EXPRESS)
# ==========================================
AUTH_PORT=3001
JWT_SECRET="clave_secreta_aleatoria"
JWT_EXPIRES_IN="24h"

# ==========================================
# BUSINESS SERVICE (FASTAPI)
# ==========================================
BUSINESS_PORT=8000

# ==========================================
# FRONTEND (VITE)
# ==========================================
VITE_AUTH_API_URL="http://localhost:3001"
VITE_BUSINESS_API_URL="http://localhost:8000"